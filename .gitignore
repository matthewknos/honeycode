# Build output. Rebuilt by ./build.sh, and a signed .app is not source.
build/

# Scratch reports from agent build loops, not part of the app.
.buildloop/

.DS_Store

# Crew lab runs — real transcripts and whatever the crew built. Evidence,
# not source, and some of it is large.
runs/

# Byte-compiled tools. `availability.py` gets imported by hand now and
# then to poke at one of its functions; the cache that leaves behind is not
# part of anything.
__pycache__/
